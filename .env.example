# --- Zorunlu ---
DATABASE_URL=postgres://payimiz:payimiz@localhost:5432/payimiz_dev
# Uygulamanın dışarıdan erişilen adresi (davet/ödeme bağlantıları bununla üretilir)
APP_URL=http://localhost:3000
# Dosya bağlantılarını imzalamak için rastgele en az 32 karakter. Örn: openssl rand -hex 32
APP_SECRET=degistir-bunu-en-az-32-karakter-rastgele
# Zamanlanmış görev uç noktasını (/api/cron) koruyan anahtar
CRON_SECRET=degistir-bunu

# --- Demo ortamı (gerçek ortamda false bırakın; ayrı veritabanı kullanın) ---
DEMO_MODE=false

# --- Ödeme sağlayıcısı: none | sandbox ---
# none    : yalnızca IBAN + "ödeme yaptım" bildirimi + alıcı onayı
# sandbox : uygulama içi DEMO simülatörü (gerçek para hareketi yok, imzalı webhook akışı test edilir)
# Gerçek sağlayıcı için docs/INTEGRATIONS.md
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

# --- OCR: none | demo | anthropic ---
OCR_PROVIDER=none
# --- Metinden harcama taslağı: rules | anthropic ---
NLP_PROVIDER=rules
# anthropic seçilirse gerekir (yalnızca sunucuda tutulur)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Sunucu tarafı konuşma çözümleme: none (tarayıcının kendi konuşma tanıması kullanılır) ---
STT_PROVIDER=none

# --- Bildirim kanalları: uygulama içi her zaman açık. email/push/whatsapp: none ---
EMAIL_PROVIDER=none
PUSH_PROVIDER=none
WHATSAPP_PROVIDER=none

# --- Analitik: db | amplitude | none ---
ANALYTICS_PROVIDER=db
AMPLITUDE_API_KEY=

# --- Kur kaynağı: manual | tcmb ---
FX_PROVIDER=manual

# --- Dosya depolama: local ---
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
